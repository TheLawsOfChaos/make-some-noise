# Build stage
FROM golang:1.21-alpine AS builder

WORKDIR /app

# Install git for fetching dependencies
RUN apk add --no-cache git

# Copy go mod files
COPY backend/go.mod backend/go.sum ./

# Download dependencies
RUN go mod download

# Copy source code and the version file
COPY backend/ .
COPY versions.json /versions.json

# Build the application
RUN VERSION=$(sed -n 's/.*"backend": *"\([^"]*\)".*/\1/p' /versions.json) && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w -X siem-event-generator/api/handlers.Version=${VERSION}" -o siem-event-generator .

# Runtime stage
FROM alpine:3.19

WORKDIR /app

# Add ca-certificates for HTTPS and create output directory
RUN apk --no-cache add ca-certificates && \
    mkdir -p /tmp/output /config

# Copy binary from builder
COPY --from=builder /app/siem-event-generator .

# Expose port
EXPOSE 8080

# Run the application
CMD ["./siem-event-generator"]
